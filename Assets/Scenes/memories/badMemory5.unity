--- !u!1001 &778256221
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 352031964}
    m_Modifications:
    - target: {fileID: 1428668581419993120, guid: 58dbf2727ab9f5c4e8d2831b9e85bcf7, type: 3}
      propertyPath: m_Name
      value: DialogueBox
      objectReference: {fileID: 0}
    - target: {fileID: 5157290041129187975, guid: 58dbf2727ab9f5c4e8d2831b9e85bcf7, type: 3}
      propertyPath: voice
      value: 
      objectReference: {fileID: 622473450}
    - target: {fileID: 5157290041129187975, guid: 58dbf2727ab9f5c4e8d2831b9e85bcf7, type: 3}
      propertyPath: textSpeed
      value: 0.05
      objectReference: {fileID: 0}
    - target: {fileID: 5157290041129187975, guid: 58dbf2727ab9f5c4e8d2831b9e85bcf7, type: 3}
      propertyPath: lines.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 5157290041129187975, guid: 58dbf2727ab9f5c4e8d2831b9e85bcf7, type: 3}
      propertyPath: lines.Array.data[0]
      value: 'Principal: I''m astounded at such a reckless display! That boy could
        have died and you''ll be lucky if his parents don''t press charges!'
      objectReference: {fileID: 0}
    - target: {fileID: 5157290041129187975, guid: 58dbf2727ab9f5c4e8d2831b9e85bcf7, type: 3}
      propertyPath: lines.Array.data[1]
      value: 'Kai: It was Ray''s idea, I barely know the kid!'
      objectReference: {fileID: 0}
    - target: {fileID: 5157290041129187975, guid: 58dbf2727ab9f5c4e8d2831b9e85bcf7, type: 3}
      propertyPath: lines.Array.data[2]
      value: 'Rick: Right! He dragged us all into it'
      objectReference: {fileID: 0}
    - target: {fileID: 5157290041129187975, guid: 58dbf2727ab9f5c4e8d2831b9e85bcf7, type: 3}
      propertyPath: lines.Array.data[3]
      value: 'Ray: What?! It wasn''t-'
      objectReference: {fileID: 0}
    - target: {fileID: 5157290041129187975, guid: 58dbf2727ab9f5c4e8d2831b9e85bcf7, type: 3}
      propertyPath: lines.Array.data[4]
      value: 'Quinn: You''re the one who said to drop water on his head!'
      objectReference: {fileID: 0}
    - target: {fileID: 5157290041129187975, guid: 58dbf2727ab9f5c4e8d2831b9e85bcf7, type: 3}
      propertyPath: lines.Array.data[5]
      value: 'Ray: I only said that because you-'
      objectReference: {fileID: 0}
    - target: {fileID: 5157290041129187975, guid: 58dbf2727ab9f5c4e8d2831b9e85bcf7, type: 3}
      propertyPath: lines.Array.data[6]
      value: 'Kai: It was all his idea!'
      objectReference: {fileID: 0}
    - target: {fileID: 5157290041129187975, guid: 58dbf2727ab9f5c4e8d2831b9e85bcf7, type: 3}
      propertyPath: lines.Array.data[7]
      value: 'Principal: Enough! No more excuses, we''ll be running a full investigation
        and regardless of what his parents decide, your punishment from this institution
        will not be lenient!'
      objectReference: {fileID: 0}
    - target: {fileID: 7157715385361043155, guid: 58dbf2727ab9f5c4e8d2831b9e85bcf7, type: 3}
