--- !u!114 &233108680534875427
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 234118788437572899}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8eec56287086ecb4cafa4b5499414508, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSystem: {fileID: 8805258210363027547}
  dialogueLines_Initial:
  - 'WHISPERING STUDENT: You''re still here too, huh...?'
  - 'WHISPERING STUDENT: I tried to leave once... doors just loop back.'
  - 'WHISPERING STUDENT: But sometimes... sometimes a smell helps me remember.'
  - 'WHISPERING STUDENT: Bread. Burnt bread... and something... sweet.'
  - 'WHISPERING STUDENT: If you''re hungry for answers... the cafeteria still remembers
    you.'
  dialogueLines_FollowUp: []
