--- !u!114 &6023289530295928018
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6022701635528680658}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8eec56287086ecb4cafa4b5499414508, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSystem: {fileID: 0}
  dialogueLines_Initial:
  - 'MR. GRAY: Sit down, please.'
  - 'MR. GRAY: You''ve been wandering these halls long enough.'
  - 'MC: You... know who I am?'
  - 'MR. GRAY: Of course I do. You''ve been here before - every time the bell rings,
    you come back.'
  dialogueLines_FollowUp:
  - 'MR. GRAY: The truth sits right where you left it.'
  - 'MR. GRAY: Under all your apologies.'
  - 'MR. GRAY: Or maybe you''d prefer the blame.'
  - 'MR. GRAY: It hides where everyone signed their names, except the ones who ran.'
