  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSystem: {fileID: 2927922466045905060}
  dialogueLines_Initial:
  - 'JANITOR''S SHADOW: Always cleaning... always cleaning... but the mess keeps
    spreading.'
  - 'JANITOR''S SHADOW: You''ve disturbed too much. The walls have eyes, and they
    saw what you found in the shadows.'
  - 'JANITOR''S SHADOW: There''s only one person who keeps the final tally.'
  - 'JANITOR''S SHADOW: If you want the truth, go face the judgment.'
  - 'JANITOR''S SHADOW: The office is waiting.'
  dialogueLines_FollowUp: []
  voice: {fileID: 3951900604943198663}
