--- !u!114 &4611999705438424769
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4612521217358474945}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8eec56287086ecb4cafa4b5499414508, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSystem: {fileID: 1000748452924247916}
  dialogueLines_Initial:
  - 'MS. VALE: Keep your voice low. The books don''t like noise.'
  - 'MC: You... work here?'
  - 'MS. VALE: Once. Or maybe I was just another story someone read and forgot to
    finish.'
  - 'MS. VALE: Do you still forget things easily?'
  dialogueLines_FollowUp:
  - 'MS. VALE: One memory hides where the pages still whisper.'
  - "MS. VALE: Look where the dust won\u2019t settle."
  - 'MS. VALE: The other lies beneath the fall of knowledge.'
  - 'MS. VALE: You''ll find it under what collapsed.'
  voice: {fileID: 5755390136791734313}
