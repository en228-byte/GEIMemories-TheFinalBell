--- !u!114 &2184109478424993416
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2183235573061418632}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8eec56287086ecb4cafa4b5499414508, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSystem: {fileID: 0}
  dialogueLines_Initial:
  - 'MARNIE: Oh, you''re late again, dear. Hungry, are we?'
  - 'MC (internal): The smell of food... but nothing''s cooking.'
  - 'MARNIE: You should sit and eat while you can. Food keeps the mind steady.'
  - 'MARNIE: ...Before it starts to rot.'
  dialogueLines_FollowUp:
  - 'MARNIE: You''re looking for something, huh?'
  - 'MARNIE: You''re looking for something, huh?'
  - 'MARNIE: Or maybe the one by the trash bin... where they made him sit.'
