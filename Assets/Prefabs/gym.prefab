--- !u!114 &2472546809672357344
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2473508539072280032}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8eec56287086ecb4cafa4b5499414508, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSystem: {fileID: 0}
  dialogueLines_Initial:
  - 'MRS. NICK: You again. Always showing up after the whistle.'
  - 'MC: ...Do I know you?'
  - 'MRS. NICK: You used to. You were one of my star players.'
  - 'MRS. NICK: Fast. Ambitious. Obsessed with winning.'
  - "MRS. NICK: Tell me \u2014 how\u2019s that working out for you?"
  dialogueLines_FollowUp:
  - 'MRS. NICK: You want to remember? '
  - 'MRS. NICK: Start where the the applause was loudest and the cheers felt like
    thunder.'
  - "MRS. NICK: You\u2019ll find what you left behind there. "
  - 'MRS. NICK: But beware, success always casts shadows.'
  - 'MRS. NICK: The second fragment is hidden in the quiet corners of your greatest
    regret.'
